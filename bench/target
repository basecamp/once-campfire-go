#!/usr/bin/env python3
"""Check median HTTP throughput against a same-machine Rust comparison."""
import argparse
import json
import statistics
from pathlib import Path

ROUTES = ['room_show', 'messages_page', 'sidebar', 'search', 'post_message']
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('results', type=Path)
p.add_argument('--concurrency', type=int, default=16)
p.add_argument('--min-ratio', type=float, default=1.0, help='Go/Rust throughput must exceed this ratio')
p.add_argument('--min-reps', type=int, default=3)
a = p.parse_args()
if a.min_ratio <= 0 or a.min_reps < 1:
    p.error('min-ratio and min-reps must be positive')
runs = json.loads((a.results / 'raw.json').read_text())
failed = False
print('| Workload | Go req/s | Rust req/s | Go / Rust | Result |')
print('|---|---:|---:|---:|---|')
for route in ROUTES:
    rates = {}
    for app in ['go', 'rust']:
        samples = [(r['rep'], s) for r in runs if r['app'] == app for s in r['http']
                   if s['route'] == route and s['conc'] == a.concurrency]
        if len(samples) < a.min_reps or len({rep for rep, _ in samples}) != len(samples):
            p.error(f'{app} {route}: need at least {a.min_reps} unique repetitions')
        if any(s['errors'] or set(s['statuses']) != {'200'} or s['ok'] <= 0 for _, s in samples):
            p.error(f'{app} {route}: incomplete or failed HTTP sample')
        rates[app] = statistics.median(s['rps'] for _, s in samples)
    ratio = rates['go'] / rates['rust']
    passed = ratio > a.min_ratio
    failed |= not passed
    print(f"| {route} | {rates['go']:,.0f} | {rates['rust']:,.0f} | {ratio:.1%} | {'PASS' if passed else 'FAIL'} |")
for r in runs:
    if r['app'] not in ['go', 'rust']:
        continue
    v = r.get('write_validation', {})
    if not v or v['expected'] <= 0 or v['expected'] != v['persisted'] or v['persisted'] != v['indexed']:
        p.error(f"{r['app']} repetition {r['rep']}: acknowledged writes not verified")
raise SystemExit(1 if failed else 0)
