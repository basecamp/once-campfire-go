#!/usr/bin/env python3
"""Summarize completed application runs without rerunning the benchmark."""
import json,statistics,sys
from pathlib import Path
out=Path(sys.argv[1]);meta=json.loads((out/'metadata.json').read_text());runs=json.loads((out/'raw.json').read_text());settings=meta['settings']
median=lambda xs:statistics.median(xs)
def spread(xs,places=0):return f'{median(xs):,.{places}f} ({min(xs):,.{places}f}–{max(xs):,.{places}f})'
lines=['# Go and Rust application benchmark','',meta['scope'],'',f"{settings['reps']} alternating repetitions; {settings['seconds']}-second HTTP samples after 2-second warmups. Four application workers on CPUs {settings['server_cpus']}; load generator on CPUs {settings['loadgen_cpus']}. HTTP uses identity encoding. Every run starts with a separate copy of the same seed.",'','HTTP response contracts compare message IDs, sidebar room IDs, avatar bytes and CSS bytes. Write checks require every successful request to persist and enter the FTS index. Cable checks require every client to subscribe and every message to arrive at every client. Upload checks fetch the actual representation and compare its bytes across applications.','', '## HTTP','', 'Rates show median (minimum–maximum); latency is the median of each run’s percentile.','', '| Workload | Clients | App | Requests/s (range) | p50 ms | p90 ms | p99 ms |','|---|---:|---|---:|---:|---:|---:|']
keys=list(dict.fromkeys((s['route'],s['conc']) for r in runs for s in r['http']))
apps=list(dict.fromkeys(r['app'] for r in runs))
for name,c in keys:
 for app in apps:
  samples=[s for r in runs if r['app']==app for s in r['http'] if s['route']==name and s['conc']==c]
  lines.append(f'| {name} | {c} | {app} | {spread([s["rps"] for s in samples])} | '+ ' | '.join(f'{median(s["latency"][p] for s in samples):.3f}' for p in ['p50_ms','p90_ms','p99_ms'])+' |')
lines+=['','## Action Cable','','Throughput counts posted messages delivered to **all** clients; one such message produces one frame per client. Latency includes delivery, rather than just accepting a post. The reference load generator reports p90 rather than p95.','','| Clients | Deflate | App | Messages/s (range) | Frames/s | Per-client p99 ms | All-clients p99 ms | Wire MB/s |','|---:|---|---|---:|---:|---:|---:|---:|']
keys=list(dict.fromkeys((s['clients'],s.get('deflate',False)) for r in runs for s in r['cable']))
for n,compression in keys:
 for app in apps:
  samples=[s['throughput'] for r in runs if r['app']==app for s in r['cable'] if s['clients']==n and s.get('deflate',False)==compression]
  if not samples:continue
  lines.append(f'| {n:,} | {compression} | {app} | {spread([s["delivered_msgs_per_sec"] for s in samples],1)} | {median(s["frames_per_sec"] for s in samples):,.0f} | {median(s["per_client"]["p99_ms"] for s in samples):.3f} | {median(s["all_clients"]["p99_ms"] for s in samples):.3f} | '+(f'{median(s["wire_mb_per_sec"] for s in samples):.1f}' if compression else 'not measured')+' |')
lines+=['','## Media and resources','','| App | Upload + thumbnail median ms | Thumbnail bytes | Startup median ms | Idle Pss MiB | After HTTP Pss MiB | Final Pss MiB | Binary MiB |','|---|---:|---:|---:|---:|---:|---:|---:|']
for app in apps:
 samples=[r for r in runs if r['app']==app];uploads=[r['upload'] for r in samples if 'upload' in r]
 valid_media=uploads and 'thumb_sha256' in uploads[0]['runs'][0]
 media=f'{median(r["median_total_ms"] for r in uploads):.2f}' if valid_media else 'not validated'
 thumb=str(uploads[0]['runs'][0]['thumb_bytes']) if valid_media else '—'
 mem=lambda k:median(r[k]['Pss'] for r in samples)/1024
 lines.append(f'| {app} | {media} | {thumb} | {median(r["startup_ms"] for r in samples):.1f} | {mem("idle_memory_kib"):.1f} | {mem("http_memory_kib"):.1f} | {mem("final_memory_kib"):.1f} | {meta["binaries"][app]["bytes"]/1024**2:.1f} |')
lines+=['','Startup includes application initialization, measured to a successful health request at 25 ms polling intervals. Final memory follows the complete workload sequence and includes allocator high-water effects; it is not a per-client memory measurement. Each media sample creates a new blob and fetches its generated thumbnail.','', '## Reproduction and limits','', '- [Raw samples](raw.json) include statuses, errors, latency distributions, delivery counters, byte hashes and memory snapshots. [Metadata](metadata.json) records source/binary/seed hashes, CPU details, affinity and load averages.', '- These are local workstation measurements, sequential within the harness. Background host activity is recorded, not eliminated. They are not a language-wide performance claim.', '- This comparison uses direct application HTTP listeners. TLS, ACME, gzip/zstd and the public response cache have separate functional tests; these numbers do not measure their throughput.', '- Screen-level HTML and network comparisons remain stricter than the functional response contracts used here. Benchmark validation is not a declaration of complete byte-for-byte UI parity.', '']
if all('write_validation' in r and 'upload' in r and 'thumb_sha256' in r['upload']['runs'][0] for r in runs):
 lines += ['## Validation totals', '', f"{len(runs)} completed application runs; {sum(r['write_validation']['persisted'] for r in runs):,} acknowledged HTTP writes verified in both messages and FTS; {sum(len(r['upload']['runs']) for r in runs)} real thumbnail samples with identical hashes. HTTP errors: {sum(s['errors'] for r in runs for s in r['http'])}. Incomplete throughput deliveries: {sum(s['throughput']['posted']-s['throughput']['complete'] for r in runs for s in r['cable'])}.", '', 'Generated HTML has different whitespace, attributes and serialization. Representative body sizes from the first repetition are shown below; comparison contracts use matching message/room IDs and the separately verified browser workflows.', '', '| Response | App | Bytes |', '|---|---|---:|']
 for r in runs:
  if r['rep']==1:
   for name,body in r['bodies'].items():lines.append(f"| {name} | {r['app']} | {body['bytes']:,} |")
 lines += ['', 'Default application logging is retained: Rust logs completed jobs; Go logs startup and job failures. Native media libraries are identical between the two applications in this run. Container byte goldens use the separately pinned toolchain.', '']
if (out/'harness.json').exists():
 lines += ['[Harness hashes and build commands](harness.json). Native binary sizes reflect these build flags; the production Go image strips symbols. Server/load-generator logs are retained alongside the raw JSON (gzip-compressed after measurement when archived).', '']
if (out/'CONTENTION.md').exists():
 lines += ['[Interrupted repetitions and resumption](CONTENTION.md): incomplete contention-affected attempts were excluded and retried with unchanged binaries and settings. Completed samples were retained. See that record for host-noise limits.', '']
(out/'report.md').write_text('\n'.join(lines))
