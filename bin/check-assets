#!/usr/bin/env python3
"""Compare every pinned frontend asset with the running Rust reference."""
from pathlib import Path
import importlib.machinery
import importlib.util
import json
import os
import sqlite3
import tempfile
import urllib.request
ROOT=Path(__file__).resolve().parents[1]
loader=importlib.machinery.SourceFileLoader('upgrade_helpers',str(ROOT/'bin/check-upgrade'))
spec=importlib.util.spec_from_loader(loader.name,loader);helper=importlib.util.module_from_spec(spec);loader.exec_module(helper)
rust=ROOT.parent/'once-campfire-rust';seed=rust/'parity/.seed/default/db/production.sqlite3'
env={k:v for k,v in os.environ.items() if not k.startswith(('THRUSTER_','CAMPFIRE_')) and k!='TLS_DOMAIN'}
for line in (rust/'parity/.env.reference').read_text().splitlines():
 if line and not line.startswith('#') and '=' in line:k,v=line.split('=',1);env[k]=v
env.update(TARGET_BIND='127.0.0.1',DISABLE_SSL='1')
with tempfile.TemporaryDirectory(prefix='assets-',dir=ROOT/'.cache/tmp') as tmp:
 work=Path(tmp);db=work/'db.sqlite3'
 with sqlite3.connect(f'file:{seed}?mode=ro',uri=True) as src,sqlite3.connect(db) as dst:src.backup(dst)
 env.update(CAMPFIRE_DATABASE_PATH=str(db),CAMPFIRE_STORAGE_PATH=str(work/'storage'))
 ours=json.loads((ROOT/'assets/generated/manifest.json').read_text())
 with helper.server(rust/'target/release/campfire',env,work,'assets-reference') as base:
  with urllib.request.urlopen(base+'/assets/.manifest.json') as response:expected=json.load(response)
  for name,entry in expected.items():
   assert ours.get(name)==entry,(name,ours.get(name),entry)
   with urllib.request.urlopen(base+'/assets/'+entry['digested_path']) as response:body=response.read()
   actual=(ROOT/'assets/generated/public/assets'/entry['digested_path']).read_bytes()
   if body!=actual:
    offset=next((i for i,(a,b) in enumerate(zip(body,actual)) if a!=b),min(len(body),len(actual)))
    raise AssertionError(f'{name} body differs at {offset}: Rust={body[offset-50:offset+150]!r} Go={actual[offset-50:offset+150]!r}')
  _,_,page=helper.request(base,'/session/new')
  for name in ('importmap.html','stylesheets.html'):
   assert (ROOT/'assets/generated'/name).read_bytes() in page,name+' differs from Rust'
  print(f'PASS: all {len(expected)} Rust asset paths and bodies, import map, and stylesheet tags match.')
