    "account_settings": account_settings,
    "direct_upload": direct_upload,
    "storage_downloads": storage_downloads,
    "attachment_lifecycle": attachment_lifecycle,
    "avatar_lifecycle": avatar_lifecycle,
    "upload_metadata": upload_metadata,
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rust-root", type=Path, default=ROOT / "reference")
    parser.add_argument("--seed", type=Path, required=True)
    parser.add_argument("--go-binary", type=Path, default=ROOT / "campfire")
    parser.add_argument("--rust-binary", type=Path, required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--only", choices=WORKFLOWS, nargs="+", default=list(WORKFLOWS))
    args = parser.parse_args()
    args.out.mkdir(parents=True, exist_ok=False)
    labels = json.loads((args.seed / "labels.json").read_text())
    env = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith(("CAMPFIRE_", "THRUSTER_")) and key != "TLS_DOMAIN"
    }
    for line in (args.rust_root / "parity/.env.reference").read_text().splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            env[key] = value
    env.update(
        DISABLE_SSL="true",
        TARGET_BIND="127.0.0.1",
        GOMAXPROCS="4",
        TOKIO_WORKER_THREADS="4",
    )
    binaries = {"rust": args.rust_binary.resolve(), "go": args.go_binary.resolve()}
    report = {
        "scope": "Functional HTTP and persisted-state contracts, not exact HTML or JavaScript parity",
        "binaries": {
            name: hashlib.sha256(binary.read_bytes()).hexdigest()
            for name, binary in binaries.items()
        },
        "tool_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "storage_tool_sha256": hashlib.sha256(
            (ROOT / "bin/parity_storage.py").read_bytes()
        ).hexdigest(),
        "labels_sha256": hashlib.sha256(
            (args.seed / "labels.json").read_bytes()
        ).hexdigest(),
        "runs": [],
    }
    failed = False
    for name in args.only:
        for implementation, binary in binaries.items():
            with tempfile.TemporaryDirectory(
                prefix="contract-", dir=args.out
            ) as temporary:
                work = Path(temporary)
                database = work / "database.sqlite3"
                with (
                    sqlite3.connect(
                        f"file:{args.seed}/db/production.sqlite3?mode=ro", uri=True
                    ) as source,
                    sqlite3.connect(database) as destination,
                ):
                    source.backup(destination)
                shutil.copytree(args.seed / "storage", work / "files")
                environment = env | {
                    "CAMPFIRE_DATABASE_PATH": str(database),
                    "CAMPFIRE_STORAGE_PATH": str(work),
                    "CAMPFIRE_FILES_PATH": str(work / "files"),
                }
                result = {
                    "workflow": name,
                    "implementation": implementation,
                    "seed_snapshot_sha256": hashlib.sha256(
                        database.read_bytes()
                    ).hexdigest(),
                }
                with upgrade.server(
                    binary, environment, args.out, implementation + "-" + name
                ) as base:
                    app = App(base, database, labels)
                    try:
                        WORKFLOWS[name](app)
                        result["pass"] = True
                    except (AssertionError, urllib.error.URLError) as error:
                        result.update(
                            {
                                "pass": False,
                                "error": str(error) or "contract assertion failed",
                                "failure_traceback": traceback.format_exc(),
                            }
                        )
                        failed = True
                    result["requests"] = app.trace
                report["runs"].append(result)
                print(
                    implementation,
                    name,
                    "PASS" if result["pass"] else "FAIL: " + result["error"],
                    flush=True,
                )
                (args.out / "report.json").write_text(
                    json.dumps(report, indent=2) + "\n"
                )
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
