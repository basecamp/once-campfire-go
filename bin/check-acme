#!/usr/bin/env python3
"""Exercise local ACME issuance and cached restart using the Pebble test CA."""
import json,os,socket,ssl,subprocess,tempfile,time,urllib.request
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
def port():
 with socket.socket() as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
def main():
 fixture=ROOT/'.cache/pebble/test'
 if not fixture.exists():
  fixture.parent.mkdir(parents=True,exist_ok=True)
  container=subprocess.check_output(['docker','create','ghcr.io/letsencrypt/pebble:latest'],text=True).strip()
  try:subprocess.check_call(['docker','cp',container+':/test',str(fixture)])
  finally:subprocess.check_call(['docker','rm',container],stdout=subprocess.DEVNULL)
 with tempfile.TemporaryDirectory(prefix='acme-',dir=ROOT/'.cache/tmp') as directory:
  work=Path(directory);http,tls,acme,management,target=[port() for _ in range(5)]
  config=json.loads((fixture/'config/pebble-config.json').read_text())
  config['pebble'].update(listenAddress=f'0.0.0.0:{acme}',managementListenAddress=f'0.0.0.0:{management}',httpPort=http,tlsPort=tls,certificate='/test/certs/localhost/cert.pem',privateKey='/test/certs/localhost/key.pem')
  (work/'pebble.json').write_text(json.dumps(config))
  name=f'campfire-go-acme-{os.getpid()}';server=None
  env=os.environ.copy();env.update(SECRET_KEY_BASE='acme-test-only',TLS_DOMAIN='campfire-go.test',ACME_DIRECTORY=f'https://localhost:{acme}/dir',SSL_CERT_FILE=str(fixture/'certs/pebble.minica.pem'),HTTP_PORT=str(http),HTTPS_PORT=str(tls),TARGET_PORT=str(target),CAMPFIRE_STORAGE_PATH=str(work/'storage'),STORAGE_PATH=str(work/'certificates'),TMPDIR=str(ROOT/'.cache/tmp'))
  def start():
   log=(work/'go.log').open('a')
   return subprocess.Popen([str(ROOT/'campfire'),'server'],cwd=ROOT,env=env,stdout=log,stderr=subprocess.STDOUT),log
  context=ssl._create_unverified_context()
  def request():
   with socket.create_connection(('127.0.0.1',tls),timeout=15) as raw:
    with context.wrap_socket(raw,server_hostname='campfire-go.test') as conn:
     cert=conn.getpeercert(binary_form=True)
     conn.sendall(b'GET /up HTTP/1.1\r\nHost: campfire-go.test\r\nConnection: close\r\n\r\n')
     response=b''
     while chunk:=conn.recv(65536):response+=chunk
     assert response.startswith(b'HTTP/1.1 200'),response
     assert b'background-color: green' in response,response
     return cert
  try:
   subprocess.check_output(['docker','run','--detach','--rm','--name',name,'--network','host','--add-host','campfire-go.test:127.0.0.1','-e','PEBBLE_VA_NOSLEEP=1','-v',f'{fixture}:/test:ro','-v',f'{work}/pebble.json:/config.json:ro','ghcr.io/letsencrypt/pebble:latest','-config','/config.json'])
   for _ in range(100):
    try:
     with urllib.request.urlopen(f'https://localhost:{acme}/dir',context=context,timeout=1) as r:assert r.status==200
     break
    except OSError:time.sleep(.1)
   server,log=start()
   for _ in range(100):
    try:
     with urllib.request.urlopen(f'http://127.0.0.1:{target}/up',timeout=1):break
    except OSError:time.sleep(.05)
   cert=request()
   assert (work/'certificates/campfire-go.test').exists() or (work/'certificates/campfire-go.test+rsa').exists(),'certificate was not cached'
   server.terminate();server.wait(timeout=15);log.close();server=None
   # Cached serving must work without the CA online.
   subprocess.check_call(['docker','stop',name],stdout=subprocess.DEVNULL)
   server,log=start()
   for _ in range(100):
    try:
     with urllib.request.urlopen(f'http://127.0.0.1:{target}/up',timeout=1):break
    except OSError:time.sleep(.05)
   assert request()==cert,'cached restart changed the issued certificate'
   print('PASS: ACME challenge validation, certificate issuance, HTTPS serving, and cached restart with the CA offline.')
  except Exception:
   if (work/'go.log').exists():print((work/'go.log').read_text())
   subprocess.run(['docker','logs',name])
   raise
  finally:
   if server is not None:server.terminate();server.wait(timeout=15);log.close()
   subprocess.run(['docker','rm','-f',name],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
if __name__=='__main__':main()
