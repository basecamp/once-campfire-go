#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p .cache/tmp .cache/go-build
export TMPDIR="$PWD/.cache/tmp" GOCACHE="$PWD/.cache/go-build" CGO_ENABLED=1
if ! command -v go >/dev/null; then exec mise exec go@1.27.1 -- "$0" "$@"; fi
if [ -n "$(gofmt -l cmd internal assets third_party/websocket/prepared.go third_party/websocket/prepared_test.go)" ]; then gofmt -l cmd internal assets third_party/websocket/prepared.go third_party/websocket/prepared_test.go; exit 1; fi
python3 bin/build-assets
go vet ./...
go test -race ./...
(cd third_party/websocket && go test -race ./...)
