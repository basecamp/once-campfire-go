#!/usr/bin/env python3
"""Verify Go/Rust login-cookie and text-message interoperability on a disposable seed copy."""
import argparse
import contextlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import sqlite3
import subprocess
import tempfile
import time
import urllib.parse
import urllib.request
import urllib.error

ROOT=Path(__file__).resolve().parents[1]
loader=importlib.machinery.SourceFileLoader('health_helpers',str(ROOT/'bench/health'))
spec=importlib.util.spec_from_loader(loader.name,loader)
helper=importlib.util.module_from_spec(spec)
loader.exec_module(helper)

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,req,fp,code,msg,headers,newurl):return None

client=urllib.request.build_opener(NoRedirect)

def request(base,path,body=None,cookie=None):
    headers={'Accept':'*/*','Accept-Encoding':'identity','Sec-Fetch-Site':'same-origin'}
    if cookie:headers['Cookie']=cookie
    if body is not None:headers['Content-Type']='application/x-www-form-urlencoded'
    req=urllib.request.Request(base+path,data=urllib.parse.urlencode(body).encode() if body is not None else None,headers=headers)
    try:response=client.open(req,timeout=10)
    except urllib.error.HTTPError as error:response=error
    with response:return response.status,response.headers,response.read()

@contextlib.contextmanager
def server(binary,env,work,name):
    port,front=helper.free_port(),helper.free_port()
    while front==port:front=helper.free_port()
    base=f'http://127.0.0.1:{port}'
    with (work/f'{name}.log').open('w') as log:
        proc=subprocess.Popen([str(binary),'server'],cwd=ROOT,env=env|{'TARGET_PORT':str(port),'HTTP_PORT':str(front)},stdout=log,stderr=subprocess.STDOUT)
        try:
            for _ in range(300):
                if proc.poll() is not None:raise RuntimeError(f'{name} exited: {(work/f"{name}.log").read_text()}')
                try:
                    status,_,body=request(base,'/up')
                    if status!=200 or body!=helper.EXPECTED:raise RuntimeError('wrong health response')
                    break
                except OSError:time.sleep(.05)
            else:raise RuntimeError(f'{name} startup timeout')
            yield base
        finally:
            proc.terminate()
            try:proc.wait(timeout=10)
            except subprocess.TimeoutExpired:proc.kill();proc.wait()

def login(base,labels):
    status,headers,_=request(base,'/session',{'email_address':labels['emails.david'],'password':labels['passwords.all']})
    assert status==302,('login',status)
    for header in headers.get_all('Set-Cookie',[]):
        if header.startswith('session_token='):return header.split(';',1)[0]
    raise AssertionError('no login cookie')

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--rust-root',type=Path,default=ROOT.parent/'once-campfire-rust')
    args=parser.parse_args();rust=args.rust_root.resolve()
    seed=rust/'parity/.seed/default'
    labels=json.loads((seed/'labels.json').read_text())
    env={k:v for k,v in os.environ.items() if not k.startswith(('THRUSTER_','CAMPFIRE_')) and k!='TLS_DOMAIN'}
    for line in (rust/'parity/.env.reference').read_text().splitlines():
        if line and not line.startswith('#') and '=' in line:k,v=line.split('=',1);env[k]=v
    env.update(DISABLE_SSL='true',TARGET_BIND='127.0.0.1',GOMAXPROCS='4',TOKIO_WORKER_THREADS='4')
    workroot=ROOT/'bench/.work';workroot.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='upgrade-',dir=workroot) as tmp:
        work=Path(tmp);dbpath=work/'database.sqlite3'
        with sqlite3.connect(f'file:{seed}/db/production.sqlite3?mode=ro',uri=True) as src,sqlite3.connect(dbpath) as dst:src.backup(dst)
        env.update(CAMPFIRE_DATABASE_PATH=str(dbpath),CAMPFIRE_STORAGE_PATH=str(work/'storage'))
        room=labels['rooms.hq'];roompath=f'/rooms/{room}';body='Go interoperability message '+str(time.time_ns())
        with server(rust/'target/release/campfire',env,work,'rust-before') as base:
            rust_cookie=login(base,labels)
            assert request(base,roompath,cookie=rust_cookie)[0]==200
        with server(ROOT/'campfire',env,work,'go') as base:
            assert request(base,roompath,cookie=rust_cookie)[0]==200,'Go rejected Rust login cookie'
            go_cookie=login(base,labels)
            status,_,_=request(base,roompath+'/messages',{'message[body]':f'<p>{body}</p>'},go_cookie)
            assert status==200,('Go message post',status)
            status,_,html=request(base,roompath+'/messages',cookie=go_cookie)
            assert status==200 and body.encode() in html,'Go did not display message'
        with server(rust/'target/release/campfire',env,work,'rust-after') as base:
            status,_,html=request(base,roompath,cookie=go_cookie)
            assert status==200,'Rust rejected Go login cookie'
            assert body.encode() in html,'Rust did not render Go-written message'
            status,_,html=request(base,'/searches?q=interoperability',cookie=go_cookie)
            assert status==200 and body.encode() in html,'Rust did not find Go-written FTS entry'
        print('PASS: Rust-issued login accepted by Go; Go-issued login accepted by Rust.')
        print('PASS: Go-written text message and FTS entry rendered and searched by Rust.')
        print('Original seed was not modified. This is interoperability coverage, not full application parity.')

if __name__=='__main__':main()
