#!/usr/bin/env python3
"""Translate the pinned Marcel tables; no installed MIME database affects uploads."""
import pathlib,re
root=pathlib.Path(__file__).resolve().parent.parent
source=(root/'reference/crates/storage/src/tables.rs').read_text()
out=['// Code generated by bin/build-mime-tables from the pinned Marcel 1.1.0 tables; DO NOT EDIT.\npackage storage\n']
for name,target,many in [('EXTENSIONS','mimeExtensions',False),('TYPE_EXTS','mimeTypeExtensions',True),('TYPE_PARENTS','mimeParents',True)]:
 section=source.split('pub static '+name+':',1)[1].split('\n];',1)[0].split('= &[',1)[1]
 out.append('var '+target+' = map[string]'+('[]string' if many else 'string')+'{\n')
 for line in section.splitlines():
  strings=re.findall(r'"(?:\\.|[^"\\])*"',line)
  if strings:out.append(strings[0]+':'+ ('{'+','.join(strings[1:])+'}' if many else strings[1])+',\n')
 out.append('}\n')
out.append('var mimeMagic = []magicEntry{\n')
section=source.split('pub static MAGIC:',1)[1].split('\n];',1)[0].split('= &[',1)[1]
for line in section.splitlines():
 m=re.search(r'\("([^"]+)", &(\[.*\])\),',line)
 if not m:continue
 body=m[2];body=re.sub(r'Some\(b("(?:\\.|[^"\\])*")\)',r'[]byte(\1)',body);body=re.sub(r'range_end: None','range_end: -1',body);body=re.sub(r'Some\((\d+)\)',r'\1',body)
 parts=re.split(r'("(?:\\.|[^"\\])*")',body)
 for i in range(0,len(parts),2):parts[i]=parts[i].replace('[]byte(','BYTES(').replace('None','nil').replace('Match {','{').replace(']','}').replace('&[','[]magicMatch{').replace('BYTES(', '[]byte(')
 body='[]magicMatch{'+''.join(parts)[1:]
 out.append('{"'+m[1]+'",'+body+'},\n')
out.append('}\n');(root/'internal/storage/mime_tables.go').write_text(''.join(out))
