#!/usr/bin/env python3
"""Verify the production image, ONCE backup hook and offline restore on disposable storage."""
from contextlib import closing
import argparse,http.cookiejar,json,os,sqlite3,subprocess,tempfile,time,urllib.parse,urllib.request
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
def docker(*args):return subprocess.check_output(['docker',*args],text=True).strip()
def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('--image',default='once-campfire-go:verification');a=p.parse_args()
 with tempfile.TemporaryDirectory(prefix='container-',dir=ROOT/'.cache/tmp') as folder:
  root=Path(folder);name=f'campfire-go-container-{os.getpid()}';container=None
  def run():
   return docker('run','--detach','--rm','--name',name,'--publish','127.0.0.1::80','--env','SECRET_KEY_BASE=container-test-only','--env','DISABLE_SSL=1','--mount',f'type=bind,src={root},dst=/rails/storage',a.image)
  def connect():
   target=json.loads(docker('inspect',name))[0]['NetworkSettings']['Ports']['80/tcp'][0]['HostPort'];base=f'http://127.0.0.1:{target}'
   for _ in range(200):
    try:
     with urllib.request.urlopen(base+'/up',timeout=1) as r:assert r.status==200
     return base
    except OSError:time.sleep(.05)
   raise RuntimeError('container failed to start')
  try:
   container=run();base=connect();jar=http.cookiejar.CookieJar();client=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
   data=urllib.parse.urlencode({'user[name]':'Container owner','user[email_address]':'container@example.test','user[password]':'container password'}).encode()
   with client.open(base+'/first_run',data=data) as r:assert r.status==200 and b'Container owner' in r.read()
   assert docker('exec',name,'id','-u')=='1000'
   docker('exec',name,'/hooks/pre-backup')
   snapshot=root/'backups/production.sqlite3'
   with closing(sqlite3.connect(snapshot)) as db:
    assert db.execute('PRAGMA integrity_check').fetchone()==('ok',)
    assert db.execute('SELECT name FROM users').fetchone()==('Container owner',)
   docker('stop',name);container=None
   # Make a deliberate post-backup change, then verify the offline hook restores the snapshot.
   with closing(sqlite3.connect(root/'db/production.sqlite3')) as db:db.execute("UPDATE users SET name='After backup'");db.commit()
   docker('run','--rm','--mount',f'type=bind,src={root},dst=/rails/storage',a.image,'/hooks/post-restore')
   with closing(sqlite3.connect(root/'db/production.sqlite3')) as db:assert db.execute('SELECT name FROM users').fetchone()==('Container owner',)
   container=run();connect()
   print('PASS: non-root production container, public listener, setup, live SQLite backup, offline ONCE restore, and restarted application.')
   print(json.dumps({'image':a.image,'id':docker('image','inspect',a.image,'--format','{{.Id}}'),'bytes':int(docker('image','inspect',a.image,'--format','{{.Size}}'))}))
  finally:
   if container:
    try:docker('stop',name)
    except subprocess.CalledProcessError:subprocess.run(['docker','rm','-f',name])
if __name__=='__main__':main()
