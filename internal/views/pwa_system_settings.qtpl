{% comment %}reference/crates/views/templates/pwa/_system_settings.html{% endcomment %}
{% func PwaSystemSettings(ctx *ViewContext) %}<details class="notifications-help hide-in-browser" data-notifications-target="details">
  <summary class="btn">
    {%s= string(ImageTag(ctx, "external/gear.svg", NewAttrs().AriaHidden().Size(20))) %}
    <strong>Check your {%s ctx.Platform.OperatingSystem %} settings</strong>
    {%s= string(ImageTag(ctx, "disclosure.svg", NewAttrs().AriaHidden().Size(10).Class("disclosure"))) %}
  </summary>

{% if ctx.Platform.Firefox && ctx.Platform.Android %}      <ol>
        <li>Tap the <em>{%s= string(ImageTag(ctx, "menu-dots-vertical.svg", NewAttrs().Alt("More options").Size(16))) %}</em> menu button.</li>
        <li>Tap <em>Settings</em>.</li>
        <li>Tap <em>Notifications</em>.</li>
        <li>Tap <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the toggle button").Size(22))) %}</em> to <em>Allow {%s Capitalize(ctx.Platform.Browser) %} notifications</em>.</li>
      </ol>
{% elseif ctx.Platform.Edge && ctx.Platform.Desktop %}      <ol>
        <li>Click <em>Start</em>, then <em>Settings</em>.</li>
        <li>Go to <em>System &gt; Notification</em>.</li>
        <li>Click <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the toggle button").Size(22))) %}</em> <em>ON</em> for Campfire.</li>
      </ol>
{% elseif (ctx.Platform.Firefox || ctx.Platform.Chrome) && ctx.Platform.Desktop %}      <ol>
{% if ctx.Platform.Windows %}          <li>Click <em>Start</em>, then <em>Settings</em>.</li>
          <li>Go to <em>System &gt; Notification</em>.</li>
          <li>Click <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the toggle button").Size(22))) %}</em> <em>ON</em> for Campfire.</li>
{% else %}          <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
          <li>Click <em>System Settings…</em>.</li>
          <li>Click <em>Notifications</em>.</li>
          <li>Click <em>Campfire</em>.</li>
          <li>Click <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the allow notifications switch").Size(22))) %}</em> to <em>Allow notifications</em>.</li>
{% endif %}      </ol>
{% elseif ctx.Platform.Safari && ctx.Platform.Desktop %}      <ol>
        <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
        <li>Click <em>System Settings…</em>.</li>
        <li>Click <em>Notifications</em>.</li>
        <li>Click <em>Campfire</em>.</li>
        <li>Click <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the allow notifications switch").Size(22))) %}</em> to <em>Allow notifications</em>.</li>
      </ol>
{% elseif (ctx.Platform.Safari || ctx.Platform.Chrome) && ctx.Platform.IOS %}      <ol>
        <li>Open the <em>{%s= string(ImageTag(ctx, "external/gear.svg", NewAttrs().AriaHidden().Size(20))) %}</em> Settings app.</li>
        <li>Scroll to and tap <em>Campfire</em>.</li>
        <li>Tap <em>Notifications</em>.</li>
        <li>Tap <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the allow notifications switch button").Size(22))) %}</em> to <em>Allow Notifications</em>.</li>
      </ol>
{% elseif ctx.Platform.Chrome && ctx.Platform.Android %}      <ol>
        <li>Open the <em>{%s= string(ImageTag(ctx, "external/gear.svg", NewAttrs().AriaHidden().Size(20))) %}</em> Settings app.</li>
        <li>Tap <em>Notifications</em>.</li>
        <li>Tap <em>App notifications</em>.</li>
        <li>Scroll to <em>Campfire</em>.</li>
        <li>Tap <em>{%s= string(ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22))) %}</em> to <em>Allow Notifications</em>.</li>
      </ol>
{% else %}      <p>Ensure notifications are allowed for {%s Capitalize(ctx.Platform.Browser) %} in your system settings.</p>
{% endif %}</details>
{% endfunc %}
