{% comment %}reference/crates/views/templates/searches/_recents.html{% endcomment %}
{% func SearchesRecents(ctx *ViewContext, index *SearchIndexView) %}{% for _, search := range index.RecentSearches %}
      <a class="align-center gap room btn txt-nowrap" href="{%s SearchPath(search) %}">
        <span class="overflow-ellipsis">“{%s search %}”</span>
</a>{% endfor %}{% if len(index.RecentSearches) > 0 %}
      <form class="button_to" method="post" action="{%s ctx.URL(RouteClearSearches()) %}"><input type="hidden" name="_method" value="delete" /><button class="btn searches__btn" data-turbo-confirm="Are you sure you want to clear your recent searches?" type="submit">
        <img aria-hidden="true" src="{%s ctx.Asset("broom.svg") %}" />
        <span class="for-screen-reader">Clear recent searches</span>
</button></form>{% endif %}{% endfunc %}
