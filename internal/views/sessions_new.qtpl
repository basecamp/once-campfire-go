{% comment %}sessions/new.html: blocks of SessionsNew, which renders them in its layout (layouts/application.html).{% endcomment %}
{% func (p *SessionsNew) Head() %}{%s= string(TurboPageRequiresReloadTag()) %}{% endfunc %}
{% func (p *SessionsNew) Content() %}<section class="txt-align-center">
  <div class="panel {% if p.Ctx.FlashAlert != nil %}shake{% endif %}">
    {%s= string(AccountLogoTag(p.Ctx, "center margin-block-end txt-xx-large")) %}

{% code form := FormWith(p.Ctx.URL(RouteSession())).Class("flex flex-column gap") %}    {% code BeginCapture(qw422016) %}
      <fieldset class="flex flex-column gap center-block upad">
        <legend class="txt-large txt-align-center"><strong>{%s p.Ctx.Account.Name %}</strong></legend>

        <div class="flex align-center gap">
          {%s= string(TranslationButton(p.Ctx, "email_address")) %}
          <label class="flex align-center gap input input--actor txt-large">
            {%s= string(form.EmailField("email_address", nil, NewAttrs().Required(true).Class("input").Autofocus().Autocomplete("username").Placeholder("Enter your email address").AttrOpt("value", p.EmailAddress))) %}
            {%s= string(ImageTag(p.Ctx, "email.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
          </label>
        </div>

        <div class="flex align-center gap">
          {%s= string(TranslationButton(p.Ctx, "password")) %}
          <label class="flex align-center gap input input--actor txt-large">
            {%s= string(form.PasswordField("password", NewAttrs().Required(true).Class("input").Autocomplete("current-password").Placeholder("Enter your password").Maxlength(72))) %}
            {%s= string(ImageTag(p.Ctx, "password.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
          </label>
        </div>

        {% code BeginCapture(qw422016) %}
          {%s= string(ImageTag(p.Ctx, "arrow-right.svg", NewAttrs().AriaHidden())) %}
          <span class="for-screen-reader">Go</span>
{% code capture2 := EndCapture(qw422016) %}{%s= string(Button(capture2, NewAttrs().Class("btn btn--reversed center txt-large").Type("submit").Name("log_in"))) %}      </fieldset>
{% code capture1 := EndCapture(qw422016) %}{%s= string(FormWithBlock(capture1, form)) %}  </div>

  {%= AccountsHelpContact(p.Ctx, p.HelpContact) %}
</section>
{% endfunc %}
