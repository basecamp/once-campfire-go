{% comment %}reference/crates/views/templates/users/new.html{% endcomment %}
{% func (p *UsersNew) Head() %}{% endfunc %}
{% func (p *UsersNew) Nav() %}  <div class="flex-item-justify-end">
    {% code BeginCapture(qw422016) %}
      {%s= string(ImageTag(p.Ctx, "login-keys.svg", NewAttrs().AriaHidden())) %}
      <span class="for-screen-reader">Sign in</span>
{% code capture1 := EndCapture(qw422016) %}{%s= string(LinkToBlock(capture1, RouteNewSession(), NewAttrs().Class("btn flex-item-justify-end"))) %}  </div>
{% endfunc %}
{% func (p *UsersNew) Content() %}{% code form := FormWith(RouteJoin(p.JoinCode)).Model("user").Class("center") %}{% code BeginCapture(qw422016) %}
  <section class="nametag u-relative">
    <div class="flex justify-center align-center pad-block">
      {%s= string(ImageTag(p.Ctx, "lanyard.svg", NewAttrs().Class("nametag__lanyard").AriaHidden())) %}
    </div>

    <div class="nametag__inner flex flex-column gap">
      <fieldset class="flex flex-column center-block">
        <legend class="txt-align-center flex gap">
          {%s= string(AccountLogoTag(p.Ctx, "")) %}
          <strong class="txt-large">{%s p.Ctx.Account.Name %}</strong>
        </legend>

        <label class="align-center center avatar__form gap" data-controller="upload-preview">
          <div class="btn input--file">
            {%s= string(ImageTag(p.Ctx, "camera.svg", NewAttrs().AriaHidden())) %}
            {%s= string(form.FileField("avatar", NewAttrs().Class("input").Accept("image/*").Data("upload_preview_target", "input").Data("action", "upload-preview#previewImage"))) %}
            <span class="for-screen-reader">Upload avatar</span>
          </div>

          <div class="btn avatar input--file txt-xx-large">
            {%s= string(ImageTag(p.Ctx, "default-avatar.svg", NewAttrs().AriaHidden().Data("upload_preview_target", "image"))) %}
            <span class="for-screen-reader">Avatar</span>
          </div>
        </label>
      </fieldset>

      <div class="flex align-center gap">
        {%s= string(TranslationButton(p.Ctx, "user_name")) %}
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          {%s= string(form.TextField("name", nil, NewAttrs().Class("input").Autocomplete("name").Placeholder("Name").Autofocus().Required(true).Data("1p-ignore", true))) %}
          {%s= string(ImageTag(p.Ctx, "person.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
        </label>
      </div>

      <div class="flex align-center gap">
        {%s= string(TranslationButton(p.Ctx, "email_address")) %}
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          {%s= string(form.EmailField("email_address", nil, NewAttrs().Class("input").Autocomplete("username").Placeholder("Email address").Required(true))) %}
          {%s= string(ImageTag(p.Ctx, "email.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
        </label>
      </div>

      <div class="flex align-center gap">
        {%s= string(TranslationButton(p.Ctx, "password")) %}
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          {%s= string(form.PasswordField("password", NewAttrs().Class("input").Autocomplete("new-password").Placeholder("Password").Required(true).Maxlength(72))) %}
          {%s= string(ImageTag(p.Ctx, "password.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
        </label>
      </div>

      {% code BeginCapture(qw422016) %}
        {%s= string(ImageTag(p.Ctx, "check.svg", NewAttrs().AriaHidden())) %}
        <span class="for-screen-reader">Save</span>
{% code capture2 := EndCapture(qw422016) %}{%s= string(Button(capture2, NewAttrs().Class("btn btn--reversed center txt-large").Type("submit"))) %}    </div>
  </section>
{% code capture1 := EndCapture(qw422016) %}{%s= string(FormWithBlock(capture1, form)) %}
{%= AccountsHelpContact(p.Ctx, p.HelpContact) %}
{% endfunc %}
