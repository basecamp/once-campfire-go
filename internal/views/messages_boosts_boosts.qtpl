{% comment %}reference/crates/views/templates/messages/boosts/_boosts.html{% endcomment %}
{% func MessagesBoostsBoosts(ctx *ViewContext, message *MessageView) %}<turbo-frame id="{%s message.DomID("boosting") %}">
  <div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0"
      data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe">
    <div class="flex-inline flex-wrap gap" id="{%s message.DomID("boosts") %}" data-turbo-streaming-target="container">{% for i := range message.Boosts %}
      {%s= CachedBoost(ctx, &message.Boosts[i]).HTML %}{% endfor %}
    </div>

    <turbo-frame id="{%s message.DomID("new_boost") %}">
      <div class="flex-inline message__boost-inline" data-controller="soft-keyboard">
        <a class="boost__action txt-small btn" action="soft-keyboard#open" href="{%s message.NewBoostPath() %}">
          <img aria-hidden="true" src="{%s ctx.Asset("boost.svg") %}" width="20" height="20" />
          <span class="for-screen-reader">Add a boost</span>
</a>      </div>
</turbo-frame>  </div>
</turbo-frame>{% endfunc %}
