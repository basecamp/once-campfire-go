{% comment %}reference/crates/views/templates/pwa/_browser_settings.html{% endcomment %}
{% func PwaBrowserSettings(ctx *ViewContext) %}{% if !((ctx.Platform.Safari || ctx.Platform.Chrome) && ctx.Platform.IOS) %}  <details class="notifications-help" data-notifications-target="details">
    <summary class="btn">
      {%= ImageTag(ctx, "external/web.svg", NewAttrs().AriaHidden().Size(20)) %}
      <strong>Check your {%s Capitalize(ctx.Platform.Browser) %} settings</strong>
      {%= ImageTag(ctx, "disclosure.svg", NewAttrs().AriaHidden().Size(10).Class("disclosure")) %}
    </summary>

{% if ctx.Platform.Firefox && ctx.Platform.Android %}        <ol>
          <li>Tap <em>{%= ImageTag(ctx, "lock.svg", NewAttrs().Alt("the View site information button").Size(20)) %}</em> in the address bar.</li>
          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
        </ol>
{% elseif ctx.Platform.Edge && ctx.Platform.Desktop %}        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>{%= ImageTag(ctx, "lock.svg", NewAttrs().Alt("the View site information button").Size(20)) %}</em> left of the address bar.</li>
          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
        </ol>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {%s Capitalize(ctx.Platform.Browser) %}.</h2>
        <ol>
{% if ctx.Platform.Windows %}            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> <em>ON</em> for {%s Capitalize(ctx.Platform.Browser) %}.</li>
{% else %}            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{%s Capitalize(ctx.Platform.Browser) %}</em>.</li>
            <li>Click <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> to <em>Allow notifications</em>.</li>
{% endif %}        </ol>
{% elseif ctx.Platform.Firefox && ctx.Platform.Desktop %}        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>{%s Capitalize(ctx.Platform.Browser) %}</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click <em>Privacy & Security</em> in the sidebar.</li>
          <li>Scroll down to <em>Permissions</em>.</li>
          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
          <li>Select <em>Allow</em> next to <em>{%s ctx.URL("/") %}</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {%s Capitalize(ctx.Platform.Browser) %}.</h2>
        <ol>
{% if ctx.Platform.Windows %}            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the toggle button").Size(22)) %}</em> <em>ON</em> for {%s Capitalize(ctx.Platform.Browser) %}.</li>
{% else %}            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{%s Capitalize(ctx.Platform.Browser) %}</em>.</li>
            <li>Click <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> to <em>Allow notifications</em>.</li>
{% endif %}        </ol>
{% elseif ctx.Platform.Chrome && ctx.Platform.Desktop %}        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click the <em>{%= ImageTag(ctx, "external/sliders.svg", NewAttrs().Alt("View site information").Size(20)) %}</em> icon in the address bar.</li>
          <li>Click <em>Site Settings</em>.</li>
          <li>Ensure notifications are <em>Allowed</em>.</li>
        </ol>

        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {%s Capitalize(ctx.Platform.Browser) %}.</h2>
        <ol>
{% if ctx.Platform.Windows %}            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> <em>ON</em> for {%s Capitalize(ctx.Platform.Browser) %}.</li>
{% else %}            <li>Click <em aria-label="the Apple menu"></em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>{%s Capitalize(ctx.Platform.Browser) %}</em>.</li>
            <li>Click <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> to <em>Allow notifications</em>.</li>
{% endif %}        </ol>
{% elseif ctx.Platform.Chrome && ctx.Platform.Android %}        <ol>
          <li>Tap the <em>{%= ImageTag(ctx, "menu-dots-vertical.svg", NewAttrs().Alt("More options").Size(16)) %}</em> menu button.</li>
          <li>Tap <em>Settings</em>.</li>
          <li>Tap <em>Notifications</em>.</li>
          <li>Tap <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> to <em>Allow {%s Capitalize(ctx.Platform.Browser) %} notifications</em>.</li>
          <li>Tap <em>{%= ImageTag(ctx, "external/switch.svg", NewAttrs().Alt("the switch").Size(22)) %}</em> next to <em>Web apps</em>.</li>
          <li>Tap <em>{%= ImageTag(ctx, "notification-bell-alert.svg", NewAttrs().Alt("the notification bell").Size(16)) %}</em> and select <em>Allow</em>.</li>
        </ol>
{% elseif ctx.Platform.Safari && ctx.Platform.Desktop %}        <ol>
          <li>Click <em>{%s Capitalize(ctx.Platform.Browser) %}</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click the <em>Websites</em> tab.</li>
          <li>Click <em>Notifications</em> in the sidebar.</li>
          <li>Click <em>{%s ctx.URL("/") %}</em> in the list.</li>
          <li>Select <em>Allow</em>.</li>
        </ol>
{% else %}        <p>Ensure notifications are enabled for <em>{%s ctx.URL("/") %}</em> in your web browser settings.</p>
{% endif %}  </details>
{% endif %}{% endfunc %}
