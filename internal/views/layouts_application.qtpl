{% func LayoutsApplication(ctx *ViewContext, p Page) %}<!DOCTYPE html>
<html>
  <head>
    {%s= string(PageTitleTag(p.PageTitle())) %}

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    {%s= string(CurrentUserMetaTags(ctx)) %}
    {%s= string(ScriptAwareActionCableMetaTag(ctx)) %}

    {%s= string(BuilderTag("meta", NewAttrs().Name("vapid-public-key").AttrOpt("content", ctx.VAPIDPublicKey))) %}
    {%s= string(BuilderTag("meta", NewAttrs().Name("turbo-prefetch").Attr("content", "true"))) %}

    {%s= string(BuilderTag("link", NewAttrs().Attr("rel", "manifest").Attr("href", "/webmanifest.json"))) %}
    {%s= string(BuilderTag("link", NewAttrs().Attr("rel", "icon").Attr("href", ctx.Account.LogoURL).Type("image/png"))) %}
    {%s= string(BuilderTag("link", NewAttrs().Attr("rel", "apple-touch-icon").Attr("href", ctx.Account.LogoURL))) %}

    {%s= string(ctx.StylesheetTags) %}
    {%s= string(CustomStylesTag(ctx)) %}

    {%s= string(ctx.ImportmapTags) %}

{%= p.Head() %}  </head>

  <body class="{%s BodyClasses(ctx, p.BodyClass()) %}" data-controller="local-time lightbox">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
{%= p.Nav() %}    </nav>

{% code notice := ctx.FlashNotice %}{% if notice == nil %}{% code notice = ctx.FlashAlert %}{% endif %}{% if notice != nil %}      <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
        <div class="flash__inner shadow" style="{% if ctx.FlashAlert != nil %}--flash-background: var(--color-negative){% endif %}">
{% if ctx.FlashAlert != nil %}            {%s= string(ImageTag(ctx, "alert.svg", NewAttrs().Aria("hidden", true).Size(24).Class("colorize--white"))) %}</span>
{% else %}            {%s= string(ImageTag(ctx, "check.svg", NewAttrs().Aria("hidden", true).Size(24).Class("colorize--white"))) %}</span>
{% endif %}        </div>
        <span class="for-screen-reader" role="alert" aria-atomic="true">{%s *notice %}</span>
      </div>
{% endif %}
    <main id="main-content">
{%= p.Content() %}
      <footer id="footer">
{%= p.Footer() %}      </footer>
    </main>

    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open">
{%= p.Sidebar() %}    </aside>

    {%= LayoutsLightbox(ctx) %}

    <a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page">
      {%s= string(ImageTag(ctx, "campfire-icon.png", NewAttrs().Alt("Campfire logo").Attr("width", 256).Attr("height", 216))) %}
    </a>
  </body>
</html>
{% endfunc %}
