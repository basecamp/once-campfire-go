{% comment %}reference/crates/views/templates/accounts/bots/_form.html{% endcomment %}
{% func AccountsBotsForm(ctx *ViewContext, form *Form, bot *BotForm) %}<h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap" data-controller="upload-preview">
  <div class="btn input--file">
    {%s= string(ImageTag(ctx, "camera.svg", NewAttrs().AriaHidden().Size(20))) %}
    {%s= string(form.FileField("avatar", NewAttrs().Class("input").Accept("image/*").Data("upload_preview_target", "input").Data("action", "upload-preview#previewImage"))) %}
    <span class="for-screen-reader">Upload bot avatar</span>
  </div>

  <div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);">
    {% code avatar := "default-bot-avatar.svg" %}{% if bot.AvatarAttachmentURL != nil %}{% code avatar = *bot.AvatarAttachmentURL %}{% endif %}{%s= string(ImageTag(ctx, avatar, NewAttrs().Alt("Bot avatar").Size(48).Data("upload_preview_target", "image"))) %}
  </div>
</label>

<div class="flex align-center gap">
  {%s= string(TranslationButton(ctx, "bot_name")) %}
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    {%s= string(form.TextField("name", bot.Name, NewAttrs().Class("input").Autocomplete("name").Placeholder("Name the bot").Autofocus().Required(true).Data("1p-ignore", true))) %}
    {%s= string(ImageTag(ctx, "bot.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
  </label>
</div>

<div class="flex align-center gap">
  {%s= string(TranslationButton(ctx, "webhook_url")) %}
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    {%s= string(form.URLField("webhook_url", bot.WebhookURL, NewAttrs().Class("input").Placeholder("Webhook URL"))) %}
    {%s= string(ImageTag(ctx, "web.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black"))) %}
  </label>
</div>

{%s= string(ProfileFormSubmitButton(ctx)) %}
{% endfunc %}
