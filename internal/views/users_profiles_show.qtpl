{% comment %}reference/crates/views/templates/users/profiles/show.html{% endcomment %}
{% func (p *UsersProfilesShow) Head() %}{% endfunc %}
{% func (p *UsersProfilesShow) Nav() %}  <div class="flex-item-justify-start">
    {%s= string(LinkBack(p.Ctx)) %}
  </div>

  <div class="flex-item-justify-end">
{% code form := FormWith(RouteSession()).Method("delete").Data("controller", "sessions") %}    {% code BeginCapture(qw422016) %}
      {%s= string(HiddenFieldTag("push_subscription_endpoint", nil, NewAttrs().Data("sessions_target", "pushSubscriptionEndpoint"))) %}

      <button class="btn" data-action="sessions#logout:prevent">
        {%= ImageTag(p.Ctx, "logout.svg", NewAttrs().AriaHidden()) %}
        <span class="for-screen-reader">Log out</span>
      </button>
{% code capture1 := EndCapture(qw422016) %}{%s= string(FormWithBlock(capture1, form)) %}  </div>
{% endfunc %}
{% func (p *UsersProfilesShow) Content() %}<section class="panel flex flex-column gap" style="view-transition-name: avatar-{%dl p.User.ID %}">
  {%= PwaInstallInstructions(p.Ctx) %}

  <div class="align-center center avatar__form gap" data-controller="upload-preview">
{% code form := p.ProfileForm().Class("txt-medium") %}    {% code BeginCapture(qw422016) %}
      <label class="btn input--file">
        {%= ImageTag(p.Ctx, "camera.svg", NewAttrs().AriaHidden().Size(20)) %}
        {%s= string(form.FileField("avatar", NewAttrs().ID("file").Class("input").Accept("image/*").Data("upload_preview_target", "input").Data("action", "upload-preview#previewImage change->form#submit"))) %}
        <span class="for-screen-reader">Upload avatar</span>
      </label>
{% code capture1 := EndCapture(qw422016) %}{%s= string(FormWithBlock(capture1, form)) %}
{% code form = p.ProfileForm() %}    {% code BeginCapture(qw422016) %}
      <label class="btn avatar input--file txt-xx-large">
        {%= ImageTag(p.Ctx, p.User.AvatarPath, NewAttrs().AriaHidden().Size(300).Data("upload_preview_target", "image")) %}
        {%s= string(form.FileField("avatar", NewAttrs().ID("file").Class("input").Accept("image/*").Data("upload_preview_target", "input").Data("action", "upload-preview#previewImage change->form#submit"))) %}
        <span class="for-screen-reader">Avatar</span>
      </label>
{% code capture2 := EndCapture(qw422016) %}{%s= string(FormWithBlock(capture2, form)) %}
{% if p.AvatarAttached %}      {% code BeginCapture(qw422016) %}
        {%= ImageTag(p.Ctx, "minus.svg", NewAttrs().AriaHidden().Size(20)) %}
        <span class="for-screen-reader">Delete avatar</span>
{% code capture3 := EndCapture(qw422016) %}{%s= string(ButtonToBlock(capture3, RouteUserAvatar(p.User.ID), NewAttrs().Method("delete").Class("btn btn--negative txt-small avatar__delete-btn"))) %}{% endif %}  </div>

{% code form = p.ProfileForm() %}  {% code BeginCapture(qw422016) %}
    <div class="flex flex-column gap">
      <div class="flex align-center gap">
        {%s= string(TranslationButton(p.Ctx, "user_name")) %}

        <label class="flex align-center gap flex-item-grow input input--actor">
          {%s= string(form.TextField("name", &p.User.Name, NewAttrs().Class("input txt-large ").Autocomplete("name").Placeholder("Enter your name").Autofocus().Required(true).Data("1p-ignore", true))) %}
          {%= ImageTag(p.Ctx, "person.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black")) %}
        </label>
      </div>

      <div class="flex align-center gap">
        {%s= string(TranslationButton(p.Ctx, "email_address")) %}

        <label class="flex align-center gap flex-item-grow input input--actor">
          {%s= string(form.EmailField("email_address", nil, NewAttrs().Class("input txt-large").AttrOpt("value", p.User.EmailAddress).Autocomplete("username").Placeholder("Enter your email address").Required(false))) %}
          {%= ImageTag(p.Ctx, "email.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black")) %}
        </label>
      </div>

      <div class="flex align-center gap">
        {%s= string(TranslationButton(p.Ctx, "update_password")) %}

        <label class="flex align-center gap flex-item-grow input input--actor">
          {%s= string(form.PasswordField("password", NewAttrs().Class("input txt-large").Autocomplete("new-password").Placeholder("Change password").Required(false).Maxlength(72))) %}
          {%= ImageTag(p.Ctx, "password.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black")) %}
        </label>
      </div>

      <div class="flex align-start gap">
        {%s= string(TranslationButton(p.Ctx, "bio")) %}

        <label class="flex align--center gap flex-item--grow input input--actor">
          {%s= string(form.TextArea("bio", p.User.Bio, NewAttrs().Class("input txt-large").Placeholder("A few words about yourself…").Maxlength(200).Rows(3).Required(false))) %}
          {%= ImageTag(p.Ctx, "bio.svg", NewAttrs().AriaHidden().Size(24).Class("colorize--black")) %}
        </label>
      </div>

      {%s= string(ProfileFormSubmitButton(p.Ctx)) %}
    </div>
{% code capture4 := EndCapture(qw422016) %}{%s= string(FormWithBlock(capture4, form)) %}
  <div class="margin-block pad-inline pad-block fill-shade border-radius">
    <menu class="flex flex-column gap margin-none pad">
      {% for i := range p.SharedMemberships %}{%= UsersProfilesMembership(p.Ctx, &p.SharedMemberships[i]) %}{% endfor %}
{% if len(p.DirectMemberships) > 0 && len(p.SharedMemberships) > 0 %}        <hr class="separator full-width" style="--border-style: solid">
{% endif %}
      {% for i := range p.DirectMemberships %}{%= UsersProfilesMembership(p.Ctx, &p.DirectMemberships[i]) %}{% endfor %}    </menu>
  </div>

  {%= UsersProfilesTransfer(p.Ctx, &p.User, p.TransferID) %}
</section>
{% endfunc %}
